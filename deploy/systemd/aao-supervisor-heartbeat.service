[Unit]
Description=AAO supervisor periodic signed heartbeat (F4-01)
After=local-fs.target systemd-tmpfiles-setup.service

[Service]
Type=oneshot
User=aao-supervisor
Group=aao-supervisor
UMask=0027
ExecStart=/srv/aao/frozen/aao-supervisor/venv/bin/python -I -c "import sys; sys.path.insert(0, '/srv/aao/frozen/aao-supervisor/tree/src'); from aao.supervisor_service import main; sys.argv[0] = 'aao-supervisor'; raise SystemExit(main())" heartbeat
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/aao-supervisor /var/lib/aao-heartbeat
