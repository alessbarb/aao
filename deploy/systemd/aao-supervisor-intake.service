# F4-03 veto intake. The auditor connects to /run/aao-veto-intake/veto.sock; the
# supervisor checks SO_PEERCRED, records the marker and signs a heartbeat before it acks.
[Unit]
Description=AAO supervisor veto intake (F4-03)
After=local-fs.target systemd-tmpfiles-setup.service

[Service]
Type=simple
User=aao-supervisor
Group=aao-supervisor
# Socket starts 0750 (group cannot connect) until serve_veto_intake chmods it to 0660;
# the window only narrows access. Heartbeat files are created 0640.
UMask=0027
ExecStart=/srv/aao/frozen/aao-supervisor/venv/bin/python -I -c "import sys; sys.path.insert(0, '/srv/aao/frozen/aao-supervisor/tree/src'); from aao.supervisor_service import main; sys.argv[0] = 'aao-supervisor'; raise SystemExit(main())" serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/aao-supervisor /var/lib/aao-heartbeat /run/aao-veto-intake

[Install]
WantedBy=multi-user.target
