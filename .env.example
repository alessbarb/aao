# AAO configuration template — NO REAL CREDENTIALS.
# Copy to .env.local and replace each CHANGE_ME placeholder with a unique secret.
# Do not commit .env.local or .env.test.
# AAO Python entrypoints load .env.local automatically for development.
# To select .env.test explicitly: AAO_ENV=test AAO_ENV_FILE=.env.test.
# Process environment variables always override dotenv values.

AAO_ENV=development
AAO_SANDBOX_QUEUE_ENABLED=false

# Docker Compose development PostgreSQL.
# Set AAO_DEV_POSTGRES_PASSWORD in the shell or pass --env-file .env.local
# to docker compose. Password should not contain URL-special characters unless
# properly percent-encoded in the PostgreSQL connection URL.
AAO_DEV_POSTGRES_PASSWORD=CHANGE_ME_UNIQUE_DATABASE_PASSWORD
AAO_POSTGRES_URL=postgresql://aao_dev:CHANGE_ME_URL_ENCODED_PASSWORD@127.0.0.1:54329/aao_dev

# Disposable integration test database ONLY; never use production data.
AAO_TEST_POSTGRES_URL=postgresql://aao_dev:CHANGE_ME_URL_ENCODED_PASSWORD@127.0.0.1:54329/aao_test
AAO_TEST_DB_DISPOSABLE=no

# Development-only CEO bearer for the PostgreSQL API. AGENT/AUDITOR tokens
# are provisioned individually through its CEO-authenticated credential API.
AAO_CEO_TOKEN=CHANGE_ME_UNIQUE_CEO_TOKEN
# SQLite prototype credentials only; not accepted by the PostgreSQL API.
AAO_WORK_TOKEN=CHANGE_ME_UNIQUE_WORKER_TOKEN
AAO_REVIEW_TOKEN=CHANGE_ME_UNIQUE_REVIEW_TOKEN

# Optional: legacy SQLite development API path.
AAO_DB_PATH=./data/aao.sqlite3

# No external-effect execution or autonomous tools should be enabled.
